---
import Layout from '../layouts/Layout.astro';
const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<Layout title="Page Not Found — FC Driegangendiner">
  <div class="flex flex-col items-center justify-center py-20 text-center animate-fade-in-up">
    <h1 class="text-7xl font-extrabold bg-gradient-to-r from-rose-400 to-rose-600 bg-clip-text text-transparent mb-4">404</h1>
    <p class="text-xl text-slate-400 mb-8">This page doesn't exist -- like VAR getting a decision right.</p>
    <a href={baseUrl} class="glass-card-sm px-6 py-3 text-emerald-400 font-bold hover:bg-white/10 transition-all no-underline">
      Back to Standings
    </a>
  </div>
</Layout>
