---
import Layout from '../layouts/Layout.astro';
const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<Layout title="Page Not Found — FC Driegangendiner">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <h1 class="text-6xl font-bold text-fpl-pink mb-4">404</h1>
    <p class="text-xl text-gray-400 mb-8">This page doesn't exist — like VAR getting a decision right.</p>
    <a href={baseUrl} class="px-6 py-3 bg-fpl-green text-fpl-purple font-bold rounded hover:bg-fpl-cyan transition-colors no-underline">
      Back to Standings
    </a>
  </div>
</Layout>
