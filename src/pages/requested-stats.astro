---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';

let dashboardData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
} catch {}

const rs = dashboardData?.requestedStats;
const recommendedXIs = rs?.recommendedXIs ?? [];
const opponentAvg = rs?.opponentAvgAgainst ?? [];
const leagueAvg = rs?.leagueAvgOpponentScore ?? 0;
const currentGw = dashboardData?.meta?.currentGameweek ?? 0;
const nextGw = currentGw + 1;

const MAURITS_ENTRY_ID = 27628;

// Position colors
const POS_COLORS: Record<string, string> = {
  GK: 'text-amber-400',
  DEF: 'text-emerald-400',
  MID: 'text-sky-400',
  FWD: 'text-rose-400',
};

const POS_BG: Record<string, string> = {
  GK: 'bg-amber-500/10 border-amber-500/20',
  DEF: 'bg-emerald-500/10 border-emerald-500/20',
  MID: 'bg-sky-500/10 border-sky-500/20',
  FWD: 'bg-rose-500/10 border-rose-500/20',
};

function formationDisplay(formation: string): string {
  return formation;
}
---

<Layout title="Requested Stats — FC Driegangendiner">
  {rs ? (
    <>
      <!-- Hero Section -->
      <div class="mb-12 animate-fade-in-up">
        <div class="text-center">
          <h1 class="text-4xl sm:text-5xl font-extrabold bg-gradient-to-r from-fpl-green via-fpl-cyan to-fpl-pink bg-clip-text text-transparent mb-3">
            Requested Stats
          </h1>
          <p class="text-slate-400 text-lg max-w-2xl mx-auto">
            Custom analytics requested by the league. Recommended lineups and luck metrics.
          </p>
          <div class="flex justify-center gap-4 mt-4 text-sm text-slate-500">
            <span class="glass-card-sm px-3 py-1">GW{currentGw} completed</span>
            <span class="glass-card-sm px-3 py-1">8 Managers</span>
          </div>
        </div>
      </div>

      <!-- Quick nav -->
      <div class="flex flex-wrap justify-center gap-2 mb-12 text-xs">
        <a href="#recommended-xi" class="glass-card-sm px-3 py-1.5 no-underline text-slate-400 hover:text-white hover:bg-white/10 transition-all">Recommended XI</a>
        <a href="#opponent-avg" class="glass-card-sm px-3 py-1.5 no-underline text-slate-400 hover:text-white hover:bg-white/10 transition-all">Opponent Avg Against</a>
      </div>

      <!-- ===== RECOMMENDED XI ===== -->
      <section id="recommended-xi" class="mb-16 animate-fade-in-up">
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-2xl font-bold text-white">Recommended XI</h2>
          <div class="flex-1 h-px bg-gradient-to-r from-fpl-green/30 to-transparent"></div>
        </div>
        <p class="text-slate-500 text-sm mb-6">
          Optimal lineup for GW{nextGw} based on fixture difficulty, recent form (last 5 GWs), clean sheet odds, and xGI. Valid formations only.
        </p>

        <div class="space-y-4">
          {recommendedXIs.map((xi: any, i: number) => {
            const isMaurits = xi.entryId === MAURITS_ENTRY_ID;
            const starters = xi.players.filter((p: any) => p.isStarter);
            const bench = xi.players.filter((p: any) => !p.isStarter);
            const gk = starters.filter((p: any) => p.positionId === 1);
            const defs = starters.filter((p: any) => p.positionId === 2);
            const mids = starters.filter((p: any) => p.positionId === 3);
            const fwds = starters.filter((p: any) => p.positionId === 4);

            return (
              <details open={isMaurits} class:list={[
                'glass-card overflow-hidden group',
                isMaurits && 'glow-cyan'
              ]}>
                <summary class="cursor-pointer p-5 flex items-center justify-between hover:bg-white/5 transition-colors list-none [&::-webkit-details-marker]:hidden">
                  <div class="flex items-center gap-4">
                    <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-white/5 text-sm font-bold text-slate-400">
                      #{i + 1}
                    </div>
                    <div>
                      <h3 class="text-lg font-bold text-white flex items-center gap-2">
                        {xi.teamName}
                        {isMaurits && <span class="text-xs font-normal text-fpl-cyan">(You)</span>}
                      </h3>
                      <p class="text-sm text-slate-500">{xi.playerName}</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-4">
                    <div class="text-right">
                      <div class="text-xs text-slate-500">Formation</div>
                      <div class="text-lg font-bold text-fpl-green tabular-nums">{xi.formation}</div>
                    </div>
                    <div class="text-right">
                      <div class="text-xs text-slate-500">Total Score</div>
                      <div class="text-lg font-bold text-fpl-cyan tabular-nums">{xi.totalStartScore.toFixed(1)}</div>
                    </div>
                    <svg class="w-5 h-5 text-slate-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </summary>

                <div class="px-5 pb-5 border-t border-white/5">
                  <!-- Starting XI -->
                  <div class="mt-4">
                    <div class="section-label mb-3">Starting XI</div>

                    <!-- Formation pitch layout -->
                    <div class="space-y-3">
                      {/* GK Row */}
                      <div class="flex justify-center gap-2">
                        {gk.map((p: any) => (
                          <div class:list={['glass-card-sm p-2.5 text-center min-w-[100px] border', POS_BG['GK']]}>
                            <div class:list={['text-xs font-semibold mb-0.5', POS_COLORS['GK']]}>GK</div>
                            <div class="text-sm font-bold text-white truncate">{p.webName}</div>
                            <div class="text-xs text-slate-500">{p.teamShort} {p.isHome ? 'vs' : '@'} {p.opponentShort}</div>
                            <div class="text-xs font-semibold text-fpl-cyan mt-1 tabular-nums">{p.startScore.toFixed(2)}</div>
                          </div>
                        ))}
                      </div>

                      {/* DEF Row */}
                      <div class="flex justify-center gap-2 flex-wrap">
                        {defs.map((p: any) => (
                          <div class:list={['glass-card-sm p-2.5 text-center min-w-[100px] border', POS_BG['DEF']]}>
                            <div class:list={['text-xs font-semibold mb-0.5', POS_COLORS['DEF']]}>DEF</div>
                            <div class="text-sm font-bold text-white truncate">{p.webName}</div>
                            <div class="text-xs text-slate-500">{p.teamShort} {p.isHome ? 'vs' : '@'} {p.opponentShort}</div>
                            <div class="text-xs font-semibold text-fpl-cyan mt-1 tabular-nums">{p.startScore.toFixed(2)}</div>
                          </div>
                        ))}
                      </div>

                      {/* MID Row */}
                      <div class="flex justify-center gap-2 flex-wrap">
                        {mids.map((p: any) => (
                          <div class:list={['glass-card-sm p-2.5 text-center min-w-[100px] border', POS_BG['MID']]}>
                            <div class:list={['text-xs font-semibold mb-0.5', POS_COLORS['MID']]}>MID</div>
                            <div class="text-sm font-bold text-white truncate">{p.webName}</div>
                            <div class="text-xs text-slate-500">{p.teamShort} {p.isHome ? 'vs' : '@'} {p.opponentShort}</div>
                            <div class="text-xs font-semibold text-fpl-cyan mt-1 tabular-nums">{p.startScore.toFixed(2)}</div>
                          </div>
                        ))}
                      </div>

                      {/* FWD Row */}
                      <div class="flex justify-center gap-2 flex-wrap">
                        {fwds.map((p: any) => (
                          <div class:list={['glass-card-sm p-2.5 text-center min-w-[100px] border', POS_BG['FWD']]}>
                            <div class:list={['text-xs font-semibold mb-0.5', POS_COLORS['FWD']]}>FWD</div>
                            <div class="text-sm font-bold text-white truncate">{p.webName}</div>
                            <div class="text-xs text-slate-500">{p.teamShort} {p.isHome ? 'vs' : '@'} {p.opponentShort}</div>
                            <div class="text-xs font-semibold text-fpl-cyan mt-1 tabular-nums">{p.startScore.toFixed(2)}</div>
                          </div>
                        ))}
                      </div>
                    </div>

                    {/* Score breakdown table */}
                    <div class="mt-4 overflow-x-auto">
                      <table class="w-full text-xs">
                        <thead>
                          <tr class="text-slate-500 border-b border-white/5">
                            <th class="text-left py-2 pr-2">Player</th>
                            <th class="text-center py-2 px-1">Pos</th>
                            <th class="text-center py-2 px-1">Match</th>
                            <th class="text-right py-2 px-1" title="Fixture difficulty (35%)">Fix</th>
                            <th class="text-right py-2 px-1" title="Recent form (35%)">Form</th>
                            <th class="text-right py-2 px-1" title="CS% / xGI (20%)">Spec</th>
                            <th class="text-right py-2 px-1" title="Season total (10%)">Szn</th>
                            <th class="text-right py-2 pl-1 font-semibold">Score</th>
                          </tr>
                        </thead>
                        <tbody>
                          {starters.map((p: any) => (
                            <tr class="border-b border-white/5 hover:bg-white/5">
                              <td class="py-1.5 pr-2 font-medium text-white">{p.webName}</td>
                              <td class:list={['text-center py-1.5 px-1 font-semibold', POS_COLORS[p.position]]}>{p.position}</td>
                              <td class="text-center py-1.5 px-1 text-slate-400">
                                {p.teamShort} {p.isHome ? 'vs' : '@'} {p.opponentShort}
                              </td>
                              <td class="text-right py-1.5 px-1 text-slate-400 tabular-nums">{p.breakdown.fixtureScore.toFixed(1)}</td>
                              <td class="text-right py-1.5 px-1 text-slate-400 tabular-nums">{p.breakdown.formScore.toFixed(1)}</td>
                              <td class="text-right py-1.5 px-1 text-slate-400 tabular-nums">{p.breakdown.specialScore.toFixed(1)}</td>
                              <td class="text-right py-1.5 px-1 text-slate-400 tabular-nums">{p.breakdown.seasonScore.toFixed(1)}</td>
                              <td class="text-right py-1.5 pl-1 font-bold text-fpl-cyan tabular-nums">{p.startScore.toFixed(2)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>

                  {/* Bench */}
                  <div class="mt-4">
                    <div class="section-label mb-2">Bench</div>
                    <div class="flex gap-2 flex-wrap">
                      {bench.map((p: any) => (
                        <div class="glass-card-sm p-2 text-center min-w-[90px] opacity-60">
                          <div class:list={['text-xs font-semibold', POS_COLORS[p.position]]}>{p.position}</div>
                          <div class="text-sm font-medium text-white truncate">{p.webName}</div>
                          <div class="text-xs text-slate-500 tabular-nums">{p.startScore.toFixed(2)}</div>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* Transfer suggestion */}
                  {xi.transferSuggestion && (
                    <div class="mt-4 glass-card-sm p-3 border border-fpl-green/20 bg-fpl-green/5">
                      <div class="section-label mb-1 text-fpl-green">Transfer Suggestion</div>
                      <div class="flex items-center gap-2 text-sm">
                        <span class="text-rose-400 font-medium">{xi.transferSuggestion.playerOut}</span>
                        <span class="text-slate-500 text-xs">({xi.transferSuggestion.playerOutScore.toFixed(2)})</span>
                        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                        <span class="text-emerald-400 font-medium">{xi.transferSuggestion.playerIn}</span>
                        <span class="text-slate-500 text-xs">({xi.transferSuggestion.playerInScore.toFixed(2)})</span>
                        <span class="text-fpl-green font-bold text-xs">+{xi.transferSuggestion.improvement.toFixed(2)}</span>
                      </div>
                    </div>
                  )}
                </div>
              </details>
            );
          })}
        </div>

        <div class="mt-4 text-xs text-slate-600">
          <p><strong>Scoring weights:</strong> Fixture difficulty 35% | Recent form (last 5 GWs) 35% | CS odds / xGI 20% | Season total 10%</p>
        </div>
      </section>

      <!-- ===== OPPONENT AVERAGE SCORE AGAINST ===== -->
      <section id="opponent-avg" class="mb-16 animate-fade-in-up">
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-2xl font-bold text-white">Opponent Average Score Against</h2>
          <div class="flex-1 h-px bg-gradient-to-r from-fpl-green/30 to-transparent"></div>
        </div>
        <p class="text-slate-500 text-sm mb-6">
          How much do your opponents score when they face you? Higher = unluckier (opponents bring their A-game against you).
          League average: <span class="text-white font-semibold">{leagueAvg.toFixed(1)}</span> pts.
        </p>

        <div class="space-y-3">
          {opponentAvg.map((r: any, i: number) => {
            const isMaurits = r.entryId === MAURITS_ENTRY_ID;
            const diff = r.avgOpponentScore - leagueAvg;
            const isUnlucky = diff > 0;
            const barWidth = Math.min(Math.abs(diff) * 10, 100);

            return (
              <details open={isMaurits} class:list={[
                'glass-card overflow-hidden group',
                isMaurits && 'glow-cyan'
              ]}>
                <summary class="cursor-pointer p-4 flex items-center justify-between hover:bg-white/5 transition-colors list-none [&::-webkit-details-marker]:hidden">
                  <div class="flex items-center gap-4">
                    <div class:list={[
                      'flex items-center justify-center w-8 h-8 rounded-lg text-sm font-bold',
                      isUnlucky ? 'bg-rose-500/10 text-rose-400' : 'bg-emerald-500/10 text-emerald-400'
                    ]}>
                      #{i + 1}
                    </div>
                    <div>
                      <h3 class="text-base font-bold text-white flex items-center gap-2">
                        {r.teamName}
                        {isMaurits && <span class="text-xs font-normal text-fpl-cyan">(You)</span>}
                      </h3>
                      <p class="text-sm text-slate-500">{r.playerName}</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-4">
                    <div class="text-right">
                      <div class="text-2xl font-extrabold tabular-nums" class:list={[isUnlucky ? 'text-rose-400' : 'text-emerald-400']}>
                        {r.avgOpponentScore.toFixed(1)}
                      </div>
                      <div class="text-xs text-slate-500">avg opp pts</div>
                    </div>
                    <div class="w-20 hidden sm:block">
                      <div class="h-2 bg-white/5 rounded-full overflow-hidden relative">
                        {/* Center line at league avg */}
                        <div class:list={[
                          'absolute h-full rounded-full',
                          isUnlucky ? 'bg-rose-500/60 right-0' : 'bg-emerald-500/60 left-0'
                        ]} style={`width: ${barWidth}%`}></div>
                      </div>
                      <div class:list={[
                        'text-xs text-center mt-0.5 font-medium tabular-nums',
                        isUnlucky ? 'text-rose-400' : 'text-emerald-400'
                      ]}>
                        {diff > 0 ? '+' : ''}{diff.toFixed(1)}
                      </div>
                    </div>
                    <div class:list={[
                      'px-2 py-1 rounded text-xs font-bold',
                      isUnlucky ? 'bg-rose-500/10 text-rose-400' : 'bg-emerald-500/10 text-emerald-400'
                    ]}>
                      {isUnlucky ? 'Unlucky' : 'Lucky'}
                    </div>
                    <svg class="w-5 h-5 text-slate-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </summary>

                <div class="px-4 pb-4 border-t border-white/5">
                  <div class="section-label mt-3 mb-2">Per-Opponent Breakdown</div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
                    {r.perOpponent.map((opp: any) => {
                      const oppDiff = opp.avgScore - leagueAvg;
                      const oppUnlucky = oppDiff > 0;
                      return (
                        <div class="glass-card-sm p-2.5 flex justify-between items-center">
                          <div>
                            <div class="text-sm font-medium text-white">{opp.opponentName.split(' ')[0]}</div>
                            <div class="text-xs text-slate-500">{opp.matches} match{opp.matches !== 1 ? 'es' : ''}</div>
                          </div>
                          <div class:list={[
                            'text-lg font-bold tabular-nums',
                            oppUnlucky ? 'text-rose-400' : 'text-emerald-400'
                          ]}>
                            {opp.avgScore.toFixed(1)}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                  <div class="mt-2 text-xs text-slate-600">
                    {r.totalMatches} total H2H matches played
                  </div>
                </div>
              </details>
            );
          })}
        </div>

        <div class="mt-6 glass-card p-4">
          <div class="section-label mb-2">How to read this</div>
          <div class="text-sm text-slate-400 space-y-1">
            <p><span class="text-rose-400 font-semibold">Unlucky</span> = opponents consistently score above the league average when facing you. Your results are worse than your team deserves.</p>
            <p><span class="text-emerald-400 font-semibold">Lucky</span> = opponents tend to have off-days when they play you. You've benefited from favorable matchups.</p>
          </div>
        </div>
      </section>
    </>
  ) : (
    <EmptyState title="Requested Stats" message="No requested stats data available. The data pipeline needs to run first." />
  )}
</Layout>
