---
import Layout from '../layouts/Layout.astro';

let dashboardData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
} catch {}

const transactions = dashboardData?.transactions ?? [];
const draftPicks = dashboardData?.draftPicks ?? [];

// Group transactions by gameweek
const txByGw = new Map<number, any[]>();
for (const t of transactions) {
  const gw = t.gameweek;
  const existing = txByGw.get(gw) ?? [];
  existing.push(t);
  txByGw.set(gw, existing);
}
const sortedGws = [...txByGw.keys()].sort((a, b) => b - a);

// Group draft picks by round
const picksByRound = new Map<number, any[]>();
for (const p of draftPicks) {
  const existing = picksByRound.get(p.round) ?? [];
  existing.push(p);
  picksByRound.set(p.round, existing);
}

// Accepted transactions only
const acceptedTx = transactions.filter((t: any) => t.result === 'accepted');
const rejectedTx = transactions.filter((t: any) => t.result === 'rejected');

// Count by manager
const txByManager = new Map<string, number>();
for (const t of acceptedTx) {
  txByManager.set(t.managerName, (txByManager.get(t.managerName) ?? 0) + 1);
}

// Auto-pick count in draft
const autoPicks = draftPicks.filter((p: any) => p.wasAuto).length;
---

<Layout title="Transfers & Draft — FC Driegangendiner">
  {dashboardData ? (
    <>
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-fpl-green mb-1">Transfers & Draft</h1>
        <p class="text-gray-400 text-sm">
          {acceptedTx.length} accepted transfers &middot; {rejectedTx.length} rejected &middot; {draftPicks.length} draft picks
        </p>
      </div>

      <!-- Tabs -->
      <div class="flex gap-4 mb-6 border-b border-white/10 pb-2">
        <a href="#transfers" class="text-fpl-green font-bold text-sm border-b-2 border-fpl-green pb-2 no-underline">Transfers</a>
        <a href="#draft" class="text-gray-400 hover:text-white text-sm pb-2 no-underline">Draft Recap</a>
      </div>

      <!-- Transfer Activity by Manager -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
        {[...txByManager.entries()]
          .sort((a, b) => b[1] - a[1])
          .map(([name, count]) => (
          <div class="bg-fpl-card rounded-lg p-3 border border-white/5 text-center">
            <div class="text-lg font-bold text-fpl-cyan">{count}</div>
            <div class="text-xs text-gray-400">{name.split(' ')[0]}</div>
          </div>
        ))}
      </div>

      <!-- Transfer Timeline -->
      <div id="transfers" class="mb-12">
        <h2 class="text-xl font-bold text-white mb-4">Transfer Timeline</h2>
        {sortedGws.map((gw) => {
          const gwTxs = txByGw.get(gw) ?? [];
          return (
            <div class="mb-6">
              <h3 class="text-sm font-bold text-gray-400 mb-2 sticky top-0 bg-fpl-dark py-1 z-10">
                Gameweek {gw}
                <span class="text-gray-600 font-normal ml-2">({gwTxs.length} transfers)</span>
              </h3>
              <div class="space-y-1">
                {gwTxs.map((t: any) => (
                  <div class:list={[
                    'flex items-center gap-3 px-3 py-2 rounded text-sm',
                    t.result === 'accepted' ? 'bg-fpl-card' : 'bg-fpl-card/50 opacity-60'
                  ]}>
                    <span class:list={[
                      'text-xs px-1.5 py-0.5 rounded font-medium',
                      t.type === 'waiver' ? 'bg-purple-900/40 text-purple-300' : 'bg-blue-900/40 text-blue-300'
                    ]}>
                      {t.type === 'waiver' ? 'W' : 'FA'}
                    </span>
                    <span class="text-gray-400 w-24 truncate">{t.managerName.split(' ')[0]}</span>
                    <span class="text-green-400">{t.playerIn}</span>
                    <span class="text-gray-600">in</span>
                    <span class="text-red-400">{t.playerOut}</span>
                    <span class="text-gray-600">out</span>
                    <span class:list={[
                      'ml-auto text-xs px-1.5 py-0.5 rounded',
                      t.result === 'accepted' ? 'bg-green-900/40 text-green-300' : 'bg-red-900/40 text-red-300'
                    ]}>
                      {t.result}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Draft Recap -->
      <div id="draft">
        <h2 class="text-xl font-bold text-white mb-2">Draft Recap</h2>
        <p class="text-sm text-gray-400 mb-4">
          {draftPicks.length} picks across {picksByRound.size} rounds
          {autoPicks > 0 && ` (${autoPicks} auto-picks)`}
        </p>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-gray-400 border-b border-white/10 text-left">
                <th class="py-2 px-2">Round</th>
                <th class="py-2 px-2">Pick</th>
                <th class="py-2 px-2">Player</th>
                <th class="py-2 px-2">Manager</th>
                <th class="py-2 px-2 text-center">Auto</th>
              </tr>
            </thead>
            <tbody>
              {draftPicks.map((p: any) => (
                <tr class="border-b border-white/5 hover:bg-white/5">
                  <td class="py-2 px-2 text-gray-400">{p.round}</td>
                  <td class="py-2 px-2 text-gray-400">{p.pick}</td>
                  <td class="py-2 px-2 text-white font-medium">{p.playerName}</td>
                  <td class="py-2 px-2 text-gray-300">{p.managerName}</td>
                  <td class="py-2 px-2 text-center">
                    {p.wasAuto && <span class="text-yellow-400 text-xs">AUTO</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </>
  ) : (
    <div class="text-center py-20">
      <h1 class="text-2xl font-bold text-fpl-green mb-4">Transfers & Draft</h1>
      <p class="text-gray-400">Data not yet available.</p>
    </div>
  )}
</Layout>
