---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';

let dashboardData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
} catch {}

const predictions = dashboardData?.predictions ?? [];
const currentGw = dashboardData?.meta?.currentGameweek ?? 0;
const nextGw = currentGw + 1;
---

<Layout title="Predictions — FC Driegangendiner">
  {dashboardData && predictions.length > 0 ? (
    <>
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-fpl-green mb-1">GW{nextGw} Predictions</h1>
        <p class="text-gray-400 text-sm">
          Expected points based on player form, xG, and xA
        </p>
        <p class="text-xs text-fpl-pink mt-1">
          Disclaimer: these are rough estimates based on historical performance, not a prediction model.
        </p>
      </div>

      <!-- Prediction Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        {predictions.map((pred: any, i: number) => (
          <div class="bg-fpl-card rounded-lg p-5 border border-white/5">
            <div class="flex justify-between items-start mb-3">
              <div>
                <div class="text-xs text-gray-500">#{i + 1}</div>
                <h3 class="text-lg font-bold text-white">{pred.teamName}</h3>
                <p class="text-sm text-gray-400">{pred.playerName}</p>
              </div>
              <div class="text-right">
                <div class="text-3xl font-bold text-fpl-cyan">{pred.predictedPoints.toFixed(0)}</div>
                <div class="text-xs text-gray-500">expected pts</div>
              </div>
            </div>

            {pred.opponent && (
              <div class="text-sm text-gray-400 mb-3">
                vs <span class="text-white">{pred.opponent.teamName}</span>
              </div>
            )}

            <div class="border-t border-white/5 pt-3">
              <div class="text-xs text-gray-500 mb-2">Top contributors</div>
              <div class="space-y-1">
                {pred.playerBreakdown
                  .sort((a: any, b: any) => b.expectedPoints - a.expectedPoints)
                  .slice(0, 5)
                  .map((p: any) => (
                  <div class="flex justify-between text-xs">
                    <span class="text-gray-300">{p.playerName}</span>
                    <span class="text-fpl-cyan font-medium">{p.expectedPoints.toFixed(1)}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </>
  ) : (
    <EmptyState title="Predictions" message="No prediction data available for the next gameweek." />
  )}
</Layout>
