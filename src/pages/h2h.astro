---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import GameweekMatchups from '../components/GameweekMatchups.svelte';

let dashboardData: any = null;
let leagueData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
  const leagueMod = await import('../../data/league.json');
  leagueData = leagueMod.default;
} catch {
  // Data not yet available
}

const h2hMatrix = dashboardData?.h2hMatrix ?? [];
const managers = dashboardData?.managers ?? [];
const standings = dashboardData?.standings ?? [];
const currentGw = dashboardData?.meta?.currentGameweek ?? 1;
const creativeStats = dashboardData?.creativeStats;

// Build manager name lookup
const managerNames = new Map<number, string>();
const managerTeams = new Map<number, string>();
for (const m of managers) {
  managerNames.set(m.leagueEntryId, m.playerName.split(' ')[0]);
  managerTeams.set(m.leagueEntryId, m.teamName);
}

// Get ordered manager IDs (by standings rank)
const orderedIds = standings.map((s: any) => s.leagueEntryId);

// Build lookup: (a,b) -> record from a's perspective
type H2HLookup = { wins: number; draws: number; losses: number; pf: number; pa: number };
const h2hLookup = new Map<string, H2HLookup>();
for (const rec of h2hMatrix) {
  h2hLookup.set(`${rec.managerA}-${rec.managerB}`, {
    wins: rec.wins, draws: rec.draws, losses: rec.losses,
    pf: rec.pointsFor, pa: rec.pointsAgainst
  });
  h2hLookup.set(`${rec.managerB}-${rec.managerA}`, {
    wins: rec.losses, draws: rec.draws, losses: rec.wins,
    pf: rec.pointsAgainst, pa: rec.pointsFor
  });
}

function getCellColor(wins: number, losses: number): string {
  if (wins > losses) return 'bg-emerald-500/10 text-emerald-300';
  if (losses > wins) return 'bg-rose-500/10 text-rose-300';
  return 'bg-white/5 text-slate-300';
}

// Build GW matchup data for the slider
const gwMatchups = (leagueData?.matches ?? [])
  .filter((m: any) => m.finished)
  .map((m: any) => {
    const e1 = leagueData.league_entries.find((e: any) => e.id === m.league_entry_1);
    const e2 = leagueData.league_entries.find((e: any) => e.id === m.league_entry_2);
    return {
      event: m.event,
      entry1: m.league_entry_1,
      entry1Name: e1 ? `${e1.player_first_name} ${e1.player_last_name}` : 'Unknown',
      entry1Team: e1?.entry_name ?? '',
      entry1Points: m.league_entry_1_points,
      entry2: m.league_entry_2,
      entry2Name: e2 ? `${e2.player_first_name} ${e2.player_last_name}` : 'Unknown',
      entry2Team: e2?.entry_name ?? '',
      entry2Points: m.league_entry_2_points,
      winner: m.winning_league_entry,
    };
  });

// Rivalry data
const rivalryData = creativeStats?.rivalryMatrix ?? [];
---

<Layout title="Head-to-Head — FC Driegangendiner">
  {dashboardData ? (
    <>
      <div class="mb-10 animate-fade-in-up">
        <h1 class="text-3xl font-extrabold bg-gradient-to-r from-fpl-green to-fpl-cyan bg-clip-text text-transparent">Head-to-Head Records</h1>
        <p class="text-slate-400 text-sm mt-2">All-time H2H records between managers</p>
      </div>

      <!-- GW Matchup Results -->
      {gwMatchups.length > 0 && (
        <div class="mb-12 animate-fade-in-up">
          <div class="flex items-center gap-3 mb-4">
            <h2 class="text-xl font-bold text-white">Gameweek Results</h2>
            <div class="flex-1 h-px bg-gradient-to-r from-white/10 to-transparent"></div>
          </div>
          <GameweekMatchups
            client:visible
            matches={JSON.stringify(gwMatchups)}
            maxGw={currentGw}
          />
        </div>
      )}

      <!-- H2H Streaks -->
      {creativeStats?.streaks && creativeStats.streaks.length > 0 && (
        <div class="mb-12 animate-fade-in-up">
          <div class="flex items-center gap-3 mb-4">
            <h2 class="text-xl font-bold text-white">Win/Loss Streaks</h2>
            <div class="flex-1 h-px bg-gradient-to-r from-white/10 to-transparent"></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {creativeStats.streaks.map((s: any) => (
              <div class="glass-card-sm p-4">
                <div class="text-sm font-semibold text-white">{s.playerName.split(' ')[0]}</div>
                <div class="flex items-center gap-3 mt-2">
                  <div>
                    <div class="text-xs text-slate-500">Current</div>
                    <div class:list={[
                      'text-lg font-bold tabular-nums',
                      s.currentStreak > 0 ? 'text-emerald-400' : s.currentStreak < 0 ? 'text-rose-400' : 'text-slate-400'
                    ]}>
                      {s.currentStreak > 0 ? `${s.currentStreak}W` : s.currentStreak < 0 ? `${Math.abs(s.currentStreak)}L` : '0'}
                    </div>
                  </div>
                  <div class="h-8 w-px bg-white/10"></div>
                  <div>
                    <div class="text-xs text-slate-500">Best</div>
                    <div class="text-lg font-bold text-emerald-400 tabular-nums">{s.longestWinStreak}W</div>
                  </div>
                  <div class="h-8 w-px bg-white/10"></div>
                  <div>
                    <div class="text-xs text-slate-500">Worst</div>
                    <div class="text-lg font-bold text-rose-400 tabular-nums">{s.longestLossStreak}L</div>
                  </div>
                </div>
                {(s.currentStreak >= 3 || s.currentStreak <= -3) && (
                  <div class:list={[
                    'text-xs font-semibold mt-2 px-2 py-0.5 rounded-full inline-block',
                    s.currentStreak >= 3 ? 'bg-emerald-500/15 text-emerald-400' : 'bg-rose-500/15 text-rose-400'
                  ]}>
                    {s.currentStreak >= 3 ? 'HOT STREAK' : 'COLD STREAK'}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- H2H Matrix -->
      <div class="mb-12 animate-fade-in-up">
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-xl font-bold text-white">H2H Matrix</h2>
          <div class="flex-1 h-px bg-gradient-to-r from-white/10 to-transparent"></div>
        </div>
        <div class="glass-card overflow-x-auto">
          <table class="text-xs sm:text-sm">
            <thead>
              <tr>
                <th class="p-3 text-left text-slate-500 sticky left-0 bg-[#0d1020] z-10 font-medium">vs</th>
                {orderedIds.map((id: number) => (
                  <th class="p-3 text-center text-slate-500 min-w-[70px] font-medium">
                    {managerNames.get(id)}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {orderedIds.map((rowId: number) => (
                <tr>
                  <td class="p-3 font-semibold text-white sticky left-0 bg-[#0d1020] z-10 whitespace-nowrap">
                    {managerNames.get(rowId)}
                  </td>
                  {orderedIds.map((colId: number) => {
                    if (rowId === colId) {
                      return <td class="p-3 text-center bg-white/[0.02] text-slate-700">-</td>;
                    }
                    const rec = h2hLookup.get(`${rowId}-${colId}`);
                    if (!rec) return <td class="p-3 text-center">?</td>;
                    return (
                      <td class={`p-3 text-center rounded-lg ${getCellColor(rec.wins, rec.losses)}`}>
                        <div class="font-bold tabular-nums">{rec.wins}-{rec.draws}-{rec.losses}</div>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Rivalry Details -->
      {rivalryData.length > 0 && (
        <div class="mb-12 animate-fade-in-up">
          <div class="flex items-center gap-3 mb-4">
            <h2 class="text-xl font-bold text-white">Rivalry Details</h2>
            <div class="flex-1 h-px bg-gradient-to-r from-white/10 to-transparent"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {rivalryData.slice(0, 6).map((r: any) => (
              <div class="glass-card-sm p-4">
                <div class="flex justify-between items-center mb-3">
                  <span class="text-sm font-semibold text-white">{r.managerAName.split(' ')[0]}</span>
                  <span class="text-xs text-slate-500 font-mono">{r.record}</span>
                  <span class="text-sm font-semibold text-white">{r.managerBName.split(' ')[0]}</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-xs text-center">
                  <div>
                    <div class="text-slate-500">Biggest Win</div>
                    <div class="text-emerald-400 font-mono font-semibold">{r.biggestWin ?? '--'}</div>
                  </div>
                  <div>
                    <div class="text-slate-500">Closest</div>
                    <div class="text-amber-400 font-mono font-semibold">{r.closestMatch ?? '--'}</div>
                  </div>
                  <div>
                    <div class="text-slate-500">Pts Diff</div>
                    <div class="text-fpl-cyan font-mono font-semibold">{r.pointsDiff > 0 ? '+' : ''}{r.pointsDiff}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Manager Comparison -->
      <div class="mb-10 animate-fade-in-up">
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-xl font-bold text-white">Manager Profiles</h2>
          <div class="flex-1 h-px bg-gradient-to-r from-white/10 to-transparent"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {managers
            .sort((a: any, b: any) => b.leaguePoints - a.leaguePoints)
            .map((m: any, i: number) => (
            <div class:list={['glass-card-sm p-5 card-interactive animate-fade-in-up', `stagger-${i + 1}`]}>
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h3 class="text-lg font-bold text-white">{m.playerName}</h3>
                  <p class="text-sm text-slate-500">{m.teamName}</p>
                </div>
                <div class="text-right">
                  <div class="text-3xl font-extrabold text-fpl-cyan tabular-nums">{m.leaguePoints}</div>
                  <div class="text-xs text-slate-600">league pts</div>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-3 text-center text-sm">
                <div>
                  <div class="text-emerald-400 font-bold tabular-nums">{m.wins}</div>
                  <div class="text-xs text-slate-600">Wins</div>
                </div>
                <div>
                  <div class="text-slate-400 font-bold tabular-nums">{m.draws}</div>
                  <div class="text-xs text-slate-600">Draws</div>
                </div>
                <div>
                  <div class="text-rose-400 font-bold tabular-nums">{m.losses}</div>
                  <div class="text-xs text-slate-600">Losses</div>
                </div>
              </div>

              <div class="mt-4 pt-4 border-t border-white/5 grid grid-cols-2 gap-3 text-sm">
                <div>
                  <span class="text-slate-600">Total pts:</span>
                  <span class="text-white ml-1 font-semibold tabular-nums">{m.totalPoints}</span>
                </div>
                <div>
                  <span class="text-slate-600">Avg/GW:</span>
                  <span class="text-white ml-1 font-semibold tabular-nums">{m.averagePoints}</span>
                </div>
                <div>
                  <span class="text-slate-600">Best GW:</span>
                  <span class="text-emerald-400 ml-1 font-semibold tabular-nums">{m.bestGw.points} <span class="text-slate-600">(GW{m.bestGw.gw})</span></span>
                </div>
                <div>
                  <span class="text-slate-600">Worst GW:</span>
                  <span class="text-rose-400 ml-1 font-semibold tabular-nums">{m.worstGw.points} <span class="text-slate-600">(GW{m.worstGw.gw})</span></span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </>
  ) : (
    <EmptyState title="Head-to-Head" />
  )}
</Layout>
