---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import GameweekMatchups from '../components/GameweekMatchups.svelte';

let dashboardData: any = null;
let leagueData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
  const leagueMod = await import('../../data/league.json');
  leagueData = leagueMod.default;
} catch {
  // Data not yet available
}

const h2hMatrix = dashboardData?.h2hMatrix ?? [];
const managers = dashboardData?.managers ?? [];
const standings = dashboardData?.standings ?? [];
const currentGw = dashboardData?.meta?.currentGameweek ?? 1;

// Build manager name lookup
const managerNames = new Map<number, string>();
const managerTeams = new Map<number, string>();
for (const m of managers) {
  managerNames.set(m.leagueEntryId, m.playerName.split(' ')[0]);
  managerTeams.set(m.leagueEntryId, m.teamName);
}

// Get ordered manager IDs (by standings rank)
const orderedIds = standings.map((s: any) => s.leagueEntryId);

// Build lookup: (a,b) -> record from a's perspective
type H2HLookup = { wins: number; draws: number; losses: number; pf: number; pa: number };
const h2hLookup = new Map<string, H2HLookup>();
for (const rec of h2hMatrix) {
  h2hLookup.set(`${rec.managerA}-${rec.managerB}`, {
    wins: rec.wins, draws: rec.draws, losses: rec.losses,
    pf: rec.pointsFor, pa: rec.pointsAgainst
  });
  h2hLookup.set(`${rec.managerB}-${rec.managerA}`, {
    wins: rec.losses, draws: rec.draws, losses: rec.wins,
    pf: rec.pointsAgainst, pa: rec.pointsFor
  });
}

function getCellColor(wins: number, losses: number): string {
  if (wins > losses) return 'bg-green-900/40 text-green-300';
  if (losses > wins) return 'bg-red-900/40 text-red-300';
  return 'bg-gray-800/40 text-gray-300';
}

// Pass data to client as JSON for the comparison feature
const h2hJson = JSON.stringify(h2hMatrix);
const managersJson = JSON.stringify(managers);

// Build GW matchup data for the slider
const gwMatchups = (leagueData?.matches ?? [])
  .filter((m: any) => m.finished)
  .map((m: any) => {
    const e1 = leagueData.league_entries.find((e: any) => e.id === m.league_entry_1);
    const e2 = leagueData.league_entries.find((e: any) => e.id === m.league_entry_2);
    return {
      event: m.event,
      entry1: m.league_entry_1,
      entry1Name: e1 ? `${e1.player_first_name} ${e1.player_last_name}` : 'Unknown',
      entry1Team: e1?.entry_name ?? '',
      entry1Points: m.league_entry_1_points,
      entry2: m.league_entry_2,
      entry2Name: e2 ? `${e2.player_first_name} ${e2.player_last_name}` : 'Unknown',
      entry2Team: e2?.entry_name ?? '',
      entry2Points: m.league_entry_2_points,
      winner: m.winning_league_entry,
    };
  });
---

<Layout title="Head-to-Head — FC Driegangendiner">
  {dashboardData ? (
    <>
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-fpl-green mb-1">Head-to-Head Records</h1>
        <p class="text-gray-400 text-sm">All-time H2H records between managers</p>
      </div>

      <!-- GW Matchup Results -->
      {gwMatchups.length > 0 && (
        <div class="mb-10">
          <h2 class="text-xl font-bold text-white mb-4">Gameweek Results</h2>
          <GameweekMatchups
            client:visible
            matches={JSON.stringify(gwMatchups)}
            maxGw={currentGw}
          />
        </div>
      )}

      <!-- H2H Matrix -->
      <div class="overflow-x-auto mb-10">
        <table class="text-xs sm:text-sm">
          <thead>
            <tr>
              <th class="p-2 text-left text-gray-400 sticky left-0 bg-fpl-dark z-10">vs</th>
              {orderedIds.map((id: number) => (
                <th class="p-2 text-center text-gray-400 min-w-[70px]">
                  {managerNames.get(id)}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {orderedIds.map((rowId: number) => (
              <tr class="border-b border-white/5">
                <td class="p-2 font-medium text-white sticky left-0 bg-fpl-dark z-10 whitespace-nowrap">
                  {managerNames.get(rowId)}
                </td>
                {orderedIds.map((colId: number) => {
                  if (rowId === colId) {
                    return <td class="p-2 text-center bg-white/5 text-gray-600">-</td>;
                  }
                  const rec = h2hLookup.get(`${rowId}-${colId}`);
                  if (!rec) return <td class="p-2 text-center">?</td>;
                  return (
                    <td class={`p-2 text-center rounded ${getCellColor(rec.wins, rec.losses)}`}>
                      <div class="font-bold">{rec.wins}-{rec.draws}-{rec.losses}</div>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Manager Comparison Section -->
      <div class="mb-8">
        <h2 class="text-xl font-bold text-white mb-4">Manager Comparison</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {managers
            .sort((a: any, b: any) => b.leaguePoints - a.leaguePoints)
            .map((m: any) => (
            <div class="bg-fpl-card rounded-lg p-5 border border-white/5">
              <div class="flex justify-between items-start mb-3">
                <div>
                  <h3 class="text-lg font-bold text-white">{m.playerName}</h3>
                  <p class="text-sm text-gray-400">{m.teamName}</p>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold text-fpl-cyan">{m.leaguePoints}</div>
                  <div class="text-xs text-gray-500">league pts</div>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-3 text-center text-sm">
                <div>
                  <div class="text-green-400 font-bold">{m.wins}</div>
                  <div class="text-xs text-gray-500">Wins</div>
                </div>
                <div>
                  <div class="text-gray-400 font-bold">{m.draws}</div>
                  <div class="text-xs text-gray-500">Draws</div>
                </div>
                <div>
                  <div class="text-red-400 font-bold">{m.losses}</div>
                  <div class="text-xs text-gray-500">Losses</div>
                </div>
              </div>

              <div class="mt-3 pt-3 border-t border-white/5 grid grid-cols-2 gap-3 text-sm">
                <div>
                  <span class="text-gray-500">Total pts:</span>
                  <span class="text-white ml-1 font-medium">{m.totalPoints}</span>
                </div>
                <div>
                  <span class="text-gray-500">Avg/GW:</span>
                  <span class="text-white ml-1 font-medium">{m.averagePoints}</span>
                </div>
                <div>
                  <span class="text-gray-500">Best GW:</span>
                  <span class="text-green-400 ml-1 font-medium">{m.bestGw.points} (GW{m.bestGw.gw})</span>
                </div>
                <div>
                  <span class="text-gray-500">Worst GW:</span>
                  <span class="text-red-400 ml-1 font-medium">{m.worstGw.points} (GW{m.worstGw.gw})</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </>
  ) : (
    <EmptyState title="Head-to-Head" />
  )}
</Layout>
