---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';

let dashboardData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
} catch {}

const freeAgents = dashboardData?.freeAgents ?? [];

// Waiver gems: high form, unowned
const waiverGems = freeAgents
  .filter((p: any) => p.form >= 5 && p.minutes > 200)
  .slice(0, 10);
---

<Layout title="Free Agents — FC Driegangendiner">
  {dashboardData ? (
    <>
      <div class="mb-10 animate-fade-in-up">
        <h1 class="text-3xl font-extrabold bg-gradient-to-r from-fpl-green to-fpl-cyan bg-clip-text text-transparent">Free Agents</h1>
        <p class="text-slate-400 text-sm mt-2">
          Best unowned players available for waiver pickup
        </p>
      </div>

      <!-- Waiver Gems -->
      {waiverGems.length > 0 && (
        <div class="mb-10 animate-fade-in-up">
          <div class="flex items-center gap-3 mb-4">
            <h2 class="text-lg font-bold text-rose-400">Waiver Gems</h2>
            <div class="flex-1 h-px bg-gradient-to-r from-rose-500/20 to-transparent"></div>
          </div>
          <p class="text-xs text-slate-500 mb-4">Unowned players with high recent form (5.0+) and significant minutes</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {waiverGems.map((p: any, i: number) => (
              <div class:list={['glass-card-sm p-4 card-interactive animate-fade-in-up', `stagger-${i + 1}`]} style="border-color: rgba(244, 63, 94, 0.12);">
                <div class="flex justify-between items-start">
                  <div>
                    <div class="font-bold text-white">{p.webName}</div>
                    <div class="text-xs text-slate-500 mt-0.5">{p.team} &middot; {p.position}</div>
                  </div>
                  <div class="text-right">
                    <div class="text-xl font-extrabold text-fpl-cyan tabular-nums">{p.totalPoints}</div>
                    <div class="text-xs text-rose-400 font-medium">Form: {p.form.toFixed(1)}</div>
                  </div>
                </div>
                <div class="flex gap-3 mt-3 text-xs text-slate-500">
                  <span>{p.goalsScored}G</span>
                  <span>{p.assists}A</span>
                  <span>xG:{p.xG.toFixed(1)}</span>
                  <span>xA:{p.xA.toFixed(1)}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Full Free Agents Table -->
      <div class="glass-card overflow-hidden animate-fade-in-up">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-slate-500 border-b border-white/5 text-left">
                <th class="py-3 px-3 font-medium">#</th>
                <th class="py-3 px-3 font-medium">Player</th>
                <th class="py-3 px-3 hidden sm:table-cell font-medium">Team</th>
                <th class="py-3 px-3 font-medium">Pos</th>
                <th class="py-3 px-3 text-center font-medium">Pts</th>
                <th class="py-3 px-3 text-center font-medium">Form</th>
                <th class="py-3 px-3 text-center hidden md:table-cell font-medium">G</th>
                <th class="py-3 px-3 text-center hidden md:table-cell font-medium">A</th>
                <th class="py-3 px-3 text-center hidden lg:table-cell font-medium">xG</th>
                <th class="py-3 px-3 text-center hidden lg:table-cell font-medium">xA</th>
                <th class="py-3 px-3 text-center hidden md:table-cell font-medium">Min</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {freeAgents.slice(0, 100).map((p: any, i: number) => (
                <tr class="table-row-hover">
                  <td class="py-2.5 px-3 text-slate-600 tabular-nums">{i + 1}</td>
                  <td class="py-2.5 px-3">
                    <span class="text-white font-semibold">{p.webName}</span>
                    <span class="sm:hidden text-xs text-slate-600 block mt-0.5">{p.team}</span>
                  </td>
                  <td class="py-2.5 px-3 text-slate-400 hidden sm:table-cell">{p.team}</td>
                  <td class:list={[
                    'py-2.5 px-3 text-xs font-semibold',
                    p.position === 'GK' ? 'text-amber-300' :
                    p.position === 'DEF' ? 'text-blue-300' :
                    p.position === 'MID' ? 'text-emerald-300' :
                    'text-rose-300'
                  ]}>{p.position}</td>
                  <td class="py-2.5 px-3 text-center font-bold text-fpl-cyan tabular-nums">{p.totalPoints}</td>
                  <td class="py-2.5 px-3 text-center text-slate-300 tabular-nums">{p.form.toFixed(1)}</td>
                  <td class="py-2.5 px-3 text-center text-slate-300 hidden md:table-cell tabular-nums">{p.goalsScored}</td>
                  <td class="py-2.5 px-3 text-center text-slate-300 hidden md:table-cell tabular-nums">{p.assists}</td>
                  <td class="py-2.5 px-3 text-center text-slate-400 hidden lg:table-cell tabular-nums">{p.xG.toFixed(1)}</td>
                  <td class="py-2.5 px-3 text-center text-slate-400 hidden lg:table-cell tabular-nums">{p.xA.toFixed(1)}</td>
                  <td class="py-2.5 px-3 text-center text-slate-500 hidden md:table-cell tabular-nums">{p.minutes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </>
  ) : (
    <EmptyState title="Free Agents" />
  )}
</Layout>
