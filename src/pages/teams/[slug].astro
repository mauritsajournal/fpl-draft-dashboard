---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const fs = await import('node:fs');
  const pathMod = await import('node:path');
  let data: any = null;
  try {
    const raw = fs.readFileSync(pathMod.resolve('data/dashboard.json'), 'utf-8');
    data = JSON.parse(raw);
  } catch {
    return [];
  }
  return data.managers.map((m: any) => ({
    params: { slug: m.teamName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') },
    props: { manager: m },
  }));
}

const { manager } = Astro.props as { manager: any };

let dashboardData: any = null;
try {
  const mod = await import('../../../data/dashboard.json');
  dashboardData = mod.default;
} catch {}

const standings = dashboardData?.standings ?? [];
const playerStats = dashboardData?.playerStats ?? [];
const benchAnalysis = dashboardData?.benchAnalysis ?? [];

const standing = standings.find((s: any) => s.leagueEntryId === manager.leagueEntryId);
const roster = playerStats
  .filter((p: any) => p.ownerLeagueEntryId === manager.leagueEntryId)
  .sort((a: any, b: any) => a.positionId - b.positionId || b.totalPoints - a.totalPoints);

const bench = benchAnalysis.find((b: any) => b.leagueEntryId === manager.leagueEntryId);

const positions = ['GK', 'DEF', 'MID', 'FWD'];
const positionColors: Record<string, string> = {
  GK: 'bg-yellow-900/30 text-yellow-300 border-yellow-700/30',
  DEF: 'bg-blue-900/30 text-blue-300 border-blue-700/30',
  MID: 'bg-green-900/30 text-green-300 border-green-700/30',
  FWD: 'bg-red-900/30 text-red-300 border-red-700/30',
};
---

<Layout title={`${manager.teamName} — FC Driegangendiner`}>
  <div class="mb-6">
    <a href={`${import.meta.env.BASE_URL}teams/`} class="text-sm text-gray-400 hover:text-fpl-green mb-2 inline-block">&larr; All Teams</a>
    <div class="flex flex-col sm:flex-row justify-between items-start gap-4">
      <div>
        <h1 class="text-2xl font-bold text-white">{manager.teamName}</h1>
        <p class="text-gray-400">{manager.playerName}</p>
      </div>
      <div class="flex gap-4 text-center">
        <div>
          <div class="text-2xl font-bold text-fpl-cyan">{standing?.rank ?? '?'}</div>
          <div class="text-xs text-gray-500">Rank</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-white">{manager.totalPoints}</div>
          <div class="text-xs text-gray-500">Total Pts</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-fpl-green">{manager.leaguePoints}</div>
          <div class="text-xs text-gray-500">League Pts</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
    <div class="bg-fpl-card rounded-lg p-3 border border-white/5 text-center">
      <div class="text-lg font-bold text-green-400">{manager.wins}</div>
      <div class="text-xs text-gray-500">Wins</div>
    </div>
    <div class="bg-fpl-card rounded-lg p-3 border border-white/5 text-center">
      <div class="text-lg font-bold text-gray-400">{manager.draws}</div>
      <div class="text-xs text-gray-500">Draws</div>
    </div>
    <div class="bg-fpl-card rounded-lg p-3 border border-white/5 text-center">
      <div class="text-lg font-bold text-red-400">{manager.losses}</div>
      <div class="text-xs text-gray-500">Losses</div>
    </div>
    <div class="bg-fpl-card rounded-lg p-3 border border-white/5 text-center">
      <div class="text-lg font-bold text-white">{manager.averagePoints}</div>
      <div class="text-xs text-gray-500">Avg/GW</div>
    </div>
  </div>

  <!-- Best/Worst -->
  <div class="grid grid-cols-2 gap-3 mb-8">
    <div class="bg-fpl-card rounded-lg p-4 border border-white/5">
      <div class="text-xs text-gray-500 mb-1">Best Gameweek</div>
      <div class="text-xl font-bold text-green-400">{manager.bestGw.points} pts</div>
      <div class="text-sm text-gray-400">GW{manager.bestGw.gw}</div>
    </div>
    <div class="bg-fpl-card rounded-lg p-4 border border-white/5">
      <div class="text-xs text-gray-500 mb-1">Worst Gameweek</div>
      <div class="text-xl font-bold text-red-400">{manager.worstGw.points} pts</div>
      <div class="text-sm text-gray-400">GW{manager.worstGw.gw}</div>
    </div>
  </div>

  {bench && (
    <div class="bg-fpl-card rounded-lg p-4 border border-white/5 mb-8">
      <div class="text-xs text-gray-500 mb-1">Bench Points (Season Total)</div>
      <div class="text-xl font-bold text-fpl-pink">{bench.totalBenchPoints} pts left on bench</div>
    </div>
  )}

  <!-- Squad by Position -->
  <h2 class="text-xl font-bold text-white mb-4">Squad ({roster.length} players)</h2>
  {positions.map((pos) => {
    const posPlayers = roster.filter((p: any) => p.position === pos);
    if (posPlayers.length === 0) return null;
    return (
      <div class="mb-6">
        <h3 class={`text-sm font-bold mb-2 ${positionColors[pos]?.split(' ')[1] ?? 'text-gray-400'}`}>
          {pos === 'GK' ? 'Goalkeepers' : pos === 'DEF' ? 'Defenders' : pos === 'MID' ? 'Midfielders' : 'Forwards'}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
          {posPlayers.map((p: any) => (
            <div class={`rounded-lg p-3 border ${positionColors[pos]}`}>
              <div class="flex justify-between items-start">
                <div>
                  <div class="font-bold text-white text-sm">{p.webName}</div>
                  <div class="text-xs text-gray-400">{p.team}</div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-fpl-cyan">{p.totalPoints}</div>
                  <div class="text-xs text-gray-500">pts</div>
                </div>
              </div>
              <div class="flex gap-3 mt-2 text-xs text-gray-400">
                <span>{p.goalsScored}G</span>
                <span>{p.assists}A</span>
                <span>xG:{p.xG.toFixed(1)}</span>
                <span>xA:{p.xA.toFixed(1)}</span>
                <span>Form:{p.form.toFixed(1)}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  })}
</Layout>
