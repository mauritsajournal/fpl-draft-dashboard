---
import Layout from '../layouts/Layout.astro';
import StandingsTable from '../components/StandingsTable.astro';
import GameweekResults from '../components/GameweekResults.astro';
import StatCard from '../components/StatCard.astro';
import EmptyState from '../components/EmptyState.astro';

let dashboardData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
} catch {
  // Data not yet available
}

const standings = dashboardData?.standings ?? [];
const managers = dashboardData?.managers ?? [];
const powerRankings = dashboardData?.powerRankings ?? [];
const meta = dashboardData?.meta;
const currentGw = meta?.currentGameweek ?? 0;

// Find current GW matchups from gameweekHistory
const gwHistory = dashboardData?.gameweekHistory ?? [];
const latestGw = gwHistory.length > 0 ? gwHistory[gwHistory.length - 1] : null;

// Find best GW scorer
let topScorerThisGw = { name: '--', points: 0 };
if (managers.length > 0) {
  for (const m of managers) {
    const lastFormPoint = m.currentForm?.[m.currentForm.length - 1] ?? 0;
    if (lastFormPoint > topScorerThisGw.points) {
      topScorerThisGw = { name: m.playerName.split(' ')[0], points: lastFormPoint };
    }
  }
}

// Find longest winning streak
function getLongestStreak(matches: any[], entryId: number): number {
  let maxStreak = 0;
  let current = 0;
  const sorted = matches
    .filter((m: any) => m.finished && (m.league_entry_1 === entryId || m.league_entry_2 === entryId))
    .sort((a: any, b: any) => a.event - b.event);

  for (const m of sorted) {
    if (m.winning_league_entry === entryId) {
      current++;
      maxStreak = Math.max(maxStreak, current);
    } else {
      current = 0;
    }
  }
  return maxStreak;
}

// Maurits Koot's entry_id for highlighting
const MAURITS_ENTRY_ID = 27628;
---

<Layout title="Standings — FC Driegangendiner">
  {dashboardData ? (
    <>
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-fpl-green mb-1">League Standings</h1>
        <p class="text-gray-400 text-sm">
          GW {currentGw} of 38 &middot; {meta.leagueName} &middot; Season {meta.season}
        </p>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <StatCard
          label="GW Leader"
          value={topScorerThisGw.name}
          detail={`${topScorerThisGw.points} pts in GW${currentGw}`}
        />
        <StatCard
          label="League Leader"
          value={standings[0]?.playerName?.split(' ')[0] ?? '--'}
          detail={`${standings[0]?.leaguePoints ?? 0} league pts`}
        />
        <StatCard
          label="Highest Points For"
          value={standings.reduce((max: any, s: any) => s.pointsFor > max.pointsFor ? s : max, standings[0])?.playerName?.split(' ')[0] ?? '--'}
          detail={`${Math.max(...standings.map((s: any) => s.pointsFor))} total pts`}
        />
        <StatCard
          label="Most Wins"
          value={standings.reduce((max: any, s: any) => s.won > max.won ? s : max, standings[0])?.playerName?.split(' ')[0] ?? '--'}
          detail={`${Math.max(...standings.map((s: any) => s.won))} wins`}
        />
      </div>

      <!-- Standings Table -->
      <StandingsTable standings={standings} highlightEntryId={MAURITS_ENTRY_ID} />

      <!-- Power Rankings -->
      {powerRankings.length > 0 && (
        <div class="mt-8">
          <h2 class="text-xl font-bold text-white mb-4">Power Rankings</h2>
          <div class="space-y-2">
            {powerRankings.map((r: any, i: number) => {
              const maxScore = powerRankings[0]?.score ?? 100;
              return (
                <div class="bg-fpl-card rounded-lg p-3 border border-white/5">
                  <div class="flex items-center gap-3 mb-2">
                    <span class="text-sm font-bold text-gray-400 w-6">#{i + 1}</span>
                    <span class="text-sm font-medium text-white flex-1">{r.teamName}</span>
                    <span class="text-lg font-bold text-fpl-cyan">{r.score}</span>
                  </div>
                  <div class="flex h-2 rounded-full overflow-hidden bg-fpl-dark">
                    <div class="bg-fpl-green/60 rounded-l" style={`width: ${(r.breakdown.form / maxScore) * 100}%`} title={`Form: ${r.breakdown.form}`} />
                    <div class="bg-fpl-cyan/60" style={`width: ${(r.breakdown.xGI / maxScore) * 100}%`} title={`xGI: ${r.breakdown.xGI}`} />
                    <div class="bg-fpl-blue/60" style={`width: ${(r.breakdown.totalPoints / maxScore) * 100}%`} title={`Points: ${r.breakdown.totalPoints}`} />
                    <div class="bg-fpl-pink/60 rounded-r" style={`width: ${(r.breakdown.fixtureDifficulty / maxScore) * 100}%`} title={`Fixtures: ${r.breakdown.fixtureDifficulty}`} />
                  </div>
                  <div class="flex gap-4 mt-1 text-xs text-gray-500">
                    <span class="text-fpl-green">Form</span>
                    <span class="text-fpl-cyan">xGI</span>
                    <span class="text-fpl-blue">Points</span>
                    <span class="text-fpl-pink">Fixtures</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- Current GW Results -->
      <GameweekResults
        gameweek={currentGw}
        standings={standings}
        managers={managers}
      />
    </>
  ) : (
    <EmptyState title="League Standings" />
  )}
</Layout>
