---
import Layout from '../layouts/Layout.astro';

let dashboardData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
} catch {}

const meta = dashboardData?.meta;

function getFreshnessColor(hours: number): string {
  if (hours < 6) return 'text-green-400';
  if (hours < 24) return 'text-yellow-400';
  return 'text-red-400';
}

function getFreshnessLabel(hours: number): string {
  if (hours < 6) return 'Fresh';
  if (hours < 24) return 'Aging';
  return 'Stale';
}

const lastUpdated = meta?.lastUpdated ? new Date(meta.lastUpdated) : null;
const hoursAgo = lastUpdated ? (Date.now() - lastUpdated.getTime()) / 3600000 : 999;
---

<Layout title="Status — FC Driegangendiner">
  {meta ? (
    <>
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-fpl-green mb-1">Data Status</h1>
        <p class="text-gray-400 text-sm">Health of the data pipeline</p>
      </div>

      <!-- Overall Health -->
      <div class="bg-fpl-card rounded-lg p-6 border border-white/5 mb-8">
        <div class="flex items-center gap-4 mb-4">
          <div class:list={[
            'w-4 h-4 rounded-full',
            hoursAgo < 6 ? 'bg-green-400' : hoursAgo < 24 ? 'bg-yellow-400' : 'bg-red-400'
          ]} />
          <div>
            <div class="text-lg font-bold text-white">
              Data is {getFreshnessLabel(hoursAgo)}
            </div>
            <div class="text-sm text-gray-400">
              Last updated: {lastUpdated?.toISOString().replace('T', ' ').slice(0, 19)} UTC
              ({Math.floor(hoursAgo)}h {Math.floor((hoursAgo % 1) * 60)}m ago)
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-sm">
          <div><span class="text-gray-500">Season:</span> <span class="text-white">{meta.season}</span></div>
          <div><span class="text-gray-500">Current GW:</span> <span class="text-white">{meta.currentGameweek}</span></div>
          <div><span class="text-gray-500">League:</span> <span class="text-white">{meta.leagueName}</span></div>
        </div>
      </div>

      <!-- Data Availability -->
      <div class="bg-fpl-card rounded-lg p-6 border border-white/5 mb-8">
        <h2 class="text-lg font-bold text-white mb-4">Data Availability</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {Object.entries(meta.dataAvailable).map(([key, available]) => (
            <div class="flex items-center gap-2">
              <div class:list={[
                'w-3 h-3 rounded-full',
                available ? 'bg-green-400' : 'bg-red-400'
              ]} />
              <span class="text-sm text-gray-300 capitalize">{key}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Fetch Errors -->
      {meta.fetchErrors.length > 0 && (
        <div class="bg-fpl-card rounded-lg p-6 border border-red-900/30 mb-8">
          <h2 class="text-lg font-bold text-red-400 mb-3">Fetch Errors</h2>
          <div class="space-y-2">
            {meta.fetchErrors.map((err: string) => (
              <div class="text-sm text-gray-300 bg-red-900/20 rounded px-3 py-2">{err}</div>
            ))}
          </div>
        </div>
      )}

      <!-- Links -->
      <div class="bg-fpl-card rounded-lg p-6 border border-white/5">
        <h2 class="text-lg font-bold text-white mb-3">Troubleshooting</h2>
        <div class="space-y-2 text-sm">
          <div>
            <a href="https://github.com/mauritsajournal/fpl-draft-dashboard/actions" target="_blank" rel="noopener" class="text-fpl-cyan hover:text-fpl-green">
              GitHub Actions Runs
            </a>
            <span class="text-gray-500"> -- check workflow history and logs</span>
          </div>
          <div>
            <a href="https://draft.premierleague.com/api/league/820/details" target="_blank" rel="noopener" class="text-fpl-cyan hover:text-fpl-green">
              FPL Draft API (League)
            </a>
            <span class="text-gray-500"> -- verify API is responding</span>
          </div>
        </div>
      </div>
    </>
  ) : (
    <div class="text-center py-20">
      <h1 class="text-2xl font-bold text-fpl-green mb-4">Data Status</h1>
      <p class="text-gray-400">No data available yet. The pipeline needs to run first.</p>
    </div>
  )}
</Layout>
