---
import Layout from '../layouts/Layout.astro';

let dashboardData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
} catch {}

const meta = dashboardData?.meta;

function getFreshnessLabel(hours: number): string {
  if (hours < 6) return 'Fresh';
  if (hours < 24) return 'Aging';
  return 'Stale';
}

const lastUpdated = meta?.lastUpdated ? new Date(meta.lastUpdated) : null;
const hoursAgo = lastUpdated ? (Date.now() - lastUpdated.getTime()) / 3600000 : 999;
---

<Layout title="Status — FC Driegangendiner">
  {meta ? (
    <>
      <div class="mb-10 animate-fade-in-up">
        <h1 class="text-3xl font-extrabold bg-gradient-to-r from-fpl-green to-fpl-cyan bg-clip-text text-transparent">Data Status</h1>
        <p class="text-slate-400 text-sm mt-2">Health of the data pipeline</p>
      </div>

      <!-- Overall Health -->
      <div class="glass-card p-6 mb-8 animate-fade-in-up">
        <div class="flex items-center gap-4 mb-4">
          <div class:list={[
            'w-4 h-4 rounded-full animate-pulse',
            hoursAgo < 6 ? 'bg-emerald-400' : hoursAgo < 24 ? 'bg-amber-400' : 'bg-rose-400'
          ]} />
          <div>
            <div class="text-lg font-bold text-white">
              Data is {getFreshnessLabel(hoursAgo)}
            </div>
            <div class="text-sm text-slate-400">
              Last updated: {lastUpdated?.toISOString().replace('T', ' ').slice(0, 19)} UTC
              ({Math.floor(hoursAgo)}h {Math.floor((hoursAgo % 1) * 60)}m ago)
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-sm">
          <div><span class="text-slate-500">Season:</span> <span class="text-white">{meta.season}</span></div>
          <div><span class="text-slate-500">Current GW:</span> <span class="text-white">{meta.currentGameweek}</span></div>
          <div><span class="text-slate-500">League:</span> <span class="text-white">{meta.leagueName}</span></div>
        </div>
      </div>

      <!-- Data Availability -->
      <div class="glass-card p-6 mb-8 animate-fade-in-up">
        <h2 class="text-lg font-bold text-white mb-4">Data Availability</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {Object.entries(meta.dataAvailable).map(([key, available]) => (
            <div class="flex items-center gap-2">
              <div class:list={[
                'w-3 h-3 rounded-full',
                available ? 'bg-emerald-400' : 'bg-rose-400'
              ]} />
              <span class="text-sm text-slate-300 capitalize">{key}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Fetch Errors -->
      {meta.fetchErrors.length > 0 && (
        <div class="glass-card p-6 mb-8 animate-fade-in-up" style="border-color: rgba(244, 63, 94, 0.2);">
          <h2 class="text-lg font-bold text-rose-400 mb-3">Fetch Errors</h2>
          <div class="space-y-2">
            {meta.fetchErrors.map((err: string) => (
              <div class="text-sm text-slate-300 bg-rose-500/10 rounded-lg px-4 py-2.5">{err}</div>
            ))}
          </div>
        </div>
      )}

      <!-- Links -->
      <div class="glass-card p-6 animate-fade-in-up">
        <h2 class="text-lg font-bold text-white mb-3">Troubleshooting</h2>
        <div class="space-y-2 text-sm">
          <div>
            <a href="https://github.com/mauritsajournal/fpl-draft-dashboard/actions" target="_blank" rel="noopener">
              GitHub Actions Runs
            </a>
            <span class="text-slate-600"> -- check workflow history and logs</span>
          </div>
          <div>
            <a href="https://draft.premierleague.com/api/league/820/details" target="_blank" rel="noopener">
              FPL Draft API (League)
            </a>
            <span class="text-slate-600"> -- verify API is responding</span>
          </div>
        </div>
      </div>
    </>
  ) : (
    <div class="text-center py-20 animate-fade-in-up">
      <h1 class="text-3xl font-extrabold bg-gradient-to-r from-fpl-green to-fpl-cyan bg-clip-text text-transparent mb-4">Data Status</h1>
      <p class="text-slate-400">No data available yet. The pipeline needs to run first.</p>
    </div>
  )}
</Layout>
