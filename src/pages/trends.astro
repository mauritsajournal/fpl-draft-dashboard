---
import Layout from '../layouts/Layout.astro';
import LineChart from '../components/LineChart.svelte';
import BenchAnalysis from '../components/BenchAnalysis.svelte';
import WhatIfAnalysis from '../components/WhatIfAnalysis.svelte';
import EmptyState from '../components/EmptyState.astro';

let dashboardData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
} catch {}

const gwHistory = dashboardData?.gameweekHistory ?? [];
const managers = dashboardData?.managers ?? [];
const standings = dashboardData?.standings ?? [];
const benchAnalysis = dashboardData?.benchAnalysis ?? [];
const whatIf = dashboardData?.whatIf ?? [];

// Build manager name lookup
const managerNames = new Map<number, string>();
for (const m of managers) {
  managerNames.set(m.leagueEntryId, m.playerName.split(' ')[0]);
}

// Position over time data
const positionData = {
  labels: gwHistory.map((snap: any) => `GW${snap.gameweek}`),
  datasets: standings.map((s: any) => ({
    label: managerNames.get(s.leagueEntryId) ?? 'Unknown',
    data: gwHistory.map((snap: any) => {
      const entry = snap.standings.find((st: any) => st.leagueEntryId === s.leagueEntryId);
      return entry?.rank ?? null;
    }),
  })),
};

// Cumulative points over time
const cumulativeData = {
  labels: gwHistory.map((snap: any) => `GW${snap.gameweek}`),
  datasets: standings.map((s: any) => ({
    label: managerNames.get(s.leagueEntryId) ?? 'Unknown',
    data: gwHistory.map((snap: any) => {
      const entry = snap.standings.find((st: any) => st.leagueEntryId === s.leagueEntryId);
      return entry?.cumulativePoints ?? 0;
    }),
  })),
};

// Points per GW
const gwPointsData = {
  labels: gwHistory.map((snap: any) => `GW${snap.gameweek}`),
  datasets: standings.map((s: any) => ({
    label: managerNames.get(s.leagueEntryId) ?? 'Unknown',
    data: gwHistory.map((snap: any) => {
      const entry = snap.standings.find((st: any) => st.leagueEntryId === s.leagueEntryId);
      return entry?.gwPoints ?? 0;
    }),
  })),
};

// Bench analysis data
const benchChartData = benchAnalysis.length > 0 ? {
  labels: benchAnalysis[0]?.perGameweek?.map((gw: any) => `GW${gw.gw}`) ?? [],
  managers: benchAnalysis
    .sort((a: any, b: any) => b.totalBenchPoints - a.totalBenchPoints)
    .map((b: any) => ({
      name: managerNames.get(b.leagueEntryId) ?? b.playerName?.split(' ')[0] ?? 'Unknown',
      totalBenchPoints: b.totalBenchPoints,
      perGw: b.perGameweek.map((gw: any) => gw.benchPoints),
      isMaurits: b.leagueEntryId === 27137,
    })),
} : null;
---

<Layout title="Trends — FC Driegangendiner">
  {gwHistory.length > 0 ? (
    <>
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-fpl-green mb-1">Gameweek Trends</h1>
        <p class="text-gray-400 text-sm">How positions and points have evolved over the season</p>
      </div>

      <div class="space-y-8">
        <LineChart
          client:visible
          data={JSON.stringify(positionData)}
          title="League Position Over Time"
          yReverse={true}
        />

        <LineChart
          client:visible
          data={JSON.stringify(cumulativeData)}
          title="Cumulative Points"
        />

        <LineChart
          client:visible
          data={JSON.stringify(gwPointsData)}
          title="Points Per Gameweek"
        />
      </div>

      {benchChartData && (
        <div class="mt-12">
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-fpl-green mb-1">Bench Analysis</h2>
            <p class="text-gray-400 text-sm">Points left on the bench each gameweek</p>
          </div>
          <BenchAnalysis
            client:visible
            data={JSON.stringify(benchChartData)}
          />
        </div>
      )}

      {whatIf.length > 0 && (
        <div class="mt-12">
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-fpl-green mb-1">Fixture Luck Analysis</h2>
            <p class="text-gray-400 text-sm">What if every manager played every other manager's schedule?</p>
          </div>
          <WhatIfAnalysis
            client:visible
            data={JSON.stringify(whatIf)}
          />
        </div>
      )}
    </>
  ) : (
    <EmptyState title="Gameweek Trends" />
  )}
</Layout>
