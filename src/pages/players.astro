---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';

let dashboardData: any = null;
try {
  const mod = await import('../../data/dashboard.json');
  dashboardData = mod.default;
} catch {}

const playerStats = dashboardData?.playerStats ?? [];
const freeAgents = dashboardData?.freeAgents ?? [];
const allPlayers = [...playerStats, ...freeAgents]
  .sort((a: any, b: any) => b.totalPoints - a.totalPoints)
  .slice(0, 200);

const MAURITS_LEAGUE_ENTRY = 27137;
---

<Layout title="Players — FC Driegangendiner">
  {dashboardData ? (
    <>
      <div class="mb-10 animate-fade-in-up">
        <h1 class="text-3xl font-extrabold bg-gradient-to-r from-fpl-green to-fpl-cyan bg-clip-text text-transparent">Player Statistics</h1>
        <p class="text-slate-400 text-sm mt-2">
          Top 200 players by total points &middot; {playerStats.length} owned, {freeAgents.length} available
        </p>
      </div>

      <div class="glass-card overflow-hidden animate-fade-in-up">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-slate-500 border-b border-white/5 text-left">
                <th class="py-3 px-3 font-medium">#</th>
                <th class="py-3 px-3 font-medium">Player</th>
                <th class="py-3 px-3 font-medium">Pos</th>
                <th class="py-3 px-3 hidden sm:table-cell font-medium">Team</th>
                <th class="py-3 px-3 hidden md:table-cell font-medium">Owner</th>
                <th class="py-3 px-3 text-center font-medium">Pts</th>
                <th class="py-3 px-3 text-center hidden sm:table-cell font-medium">G</th>
                <th class="py-3 px-3 text-center hidden sm:table-cell font-medium">A</th>
                <th class="py-3 px-3 text-center hidden md:table-cell font-medium">xG</th>
                <th class="py-3 px-3 text-center hidden md:table-cell font-medium">xA</th>
                <th class="py-3 px-3 text-center hidden lg:table-cell font-medium">Form</th>
                <th class="py-3 px-3 text-center hidden lg:table-cell font-medium">Min</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {allPlayers.map((p: any, i: number) => {
                const isMauritsPlayer = p.ownerLeagueEntryId === MAURITS_LEAGUE_ENTRY;
                return (
                  <tr class:list={[
                    'table-row-hover',
                    isMauritsPlayer && 'bg-emerald-500/5'
                  ]}>
                    <td class="py-2.5 px-3 text-slate-600 tabular-nums">{i + 1}</td>
                    <td class="py-2.5 px-3">
                      <span class="text-white font-semibold">{p.webName}</span>
                    </td>
                    <td class:list={[
                      'py-2.5 px-3 text-xs font-semibold',
                      p.position === 'GK' ? 'text-amber-300' :
                      p.position === 'DEF' ? 'text-blue-300' :
                      p.position === 'MID' ? 'text-emerald-300' :
                      'text-rose-300'
                    ]}>{p.position}</td>
                    <td class="py-2.5 px-3 text-slate-400 hidden sm:table-cell">{p.team}</td>
                    <td class="py-2.5 px-3 hidden md:table-cell">
                      {p.owner ? (
                        <span class:list={[
                          'text-sm',
                          isMauritsPlayer ? 'text-emerald-400 font-medium' : 'text-slate-400'
                        ]}>{p.owner.split(' ')[0]}</span>
                      ) : (
                        <span class="text-xs text-fpl-blue/70 bg-fpl-blue/10 px-1.5 py-0.5 rounded">Available</span>
                      )}
                    </td>
                    <td class="py-2.5 px-3 text-center font-bold text-fpl-cyan tabular-nums">{p.totalPoints}</td>
                    <td class="py-2.5 px-3 text-center text-slate-300 hidden sm:table-cell tabular-nums">{p.goalsScored}</td>
                    <td class="py-2.5 px-3 text-center text-slate-300 hidden sm:table-cell tabular-nums">{p.assists}</td>
                    <td class="py-2.5 px-3 text-center text-slate-400 hidden md:table-cell tabular-nums">{p.xG.toFixed(1)}</td>
                    <td class="py-2.5 px-3 text-center text-slate-400 hidden md:table-cell tabular-nums">{p.xA.toFixed(1)}</td>
                    <td class="py-2.5 px-3 text-center text-slate-400 hidden lg:table-cell tabular-nums">{p.form.toFixed(1)}</td>
                    <td class="py-2.5 px-3 text-center text-slate-500 hidden lg:table-cell tabular-nums">{p.minutes}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </>
  ) : (
    <EmptyState title="Player Statistics" />
  )}
</Layout>
