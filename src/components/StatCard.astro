---
interface Props {
  label: string;
  value: string;
  detail?: string;
}

const { label, value, detail } = Astro.props;
---

<div class="bg-fpl-card rounded-lg p-4 border border-white/5">
  <div class="text-xs text-gray-500 uppercase tracking-wider mb-1">{label}</div>
  <div class="text-xl font-bold text-white">{value}</div>
  {detail && <div class="text-xs text-gray-400 mt-1">{detail}</div>}
</div>
