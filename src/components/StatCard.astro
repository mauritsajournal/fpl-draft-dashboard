---
interface Props {
  label: string;
  value: string;
  detail?: string;
  accent?: 'green' | 'cyan' | 'pink' | 'amber' | 'white';
}

const { label, value, detail, accent = 'cyan' } = Astro.props;

const accentColors: Record<string, string> = {
  green: 'text-emerald-400',
  cyan: 'text-fpl-cyan',
  pink: 'text-rose-400',
  amber: 'text-amber-400',
  white: 'text-white',
};
---

<div class="glass-card-sm p-5 animate-fade-in-up">
  <div class="section-label mb-2">{label}</div>
  <div class:list={['text-2xl font-bold', accentColors[accent] ?? 'text-white']}>{value}</div>
  {detail && <div class="text-xs text-slate-400 mt-1.5">{detail}</div>}
</div>
