---
interface Standing {
  rank: number;
  lastRank: number;
  leagueEntryId: number;
  entryId: number;
  teamName: string;
  playerName: string;
  played: number;
  won: number;
  drawn: number;
  lost: number;
  pointsFor: number;
  pointsAgainst: number;
  leaguePoints: number;
}

interface Props {
  standings: Standing[];
  highlightEntryId?: number;
  formData?: Record<number, { form: number[]; formRating: number; trend: string }>;
}

const { standings, highlightEntryId, formData } = Astro.props;

function getRankChange(current: number, last: number): string {
  if (last === 0) return '';
  const diff = last - current;
  if (diff > 0) return `+${diff}`;
  if (diff < 0) return `${diff}`;
  return '=';
}

function getRankIcon(current: number, last: number): string {
  if (last === 0) return '';
  const diff = last - current;
  if (diff > 0) return 'up';
  if (diff < 0) return 'down';
  return 'same';
}

function getRankBorder(rank: number): string {
  if (rank === 1) return 'rank-gold';
  if (rank === 2) return 'rank-silver';
  if (rank === 3) return 'rank-bronze';
  return '';
}
---

<div class="glass-card overflow-hidden animate-fade-in-up">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-slate-500 border-b border-white/5 text-left">
          <th class="py-4 px-4 w-8 font-medium">#</th>
          <th class="py-4 px-2 w-8 font-medium"></th>
          <th class="py-4 px-3 font-medium">Team</th>
          <th class="py-4 px-3 hidden sm:table-cell font-medium">Manager</th>
          <th class="py-4 px-2 text-center font-medium">P</th>
          <th class="py-4 px-2 text-center font-medium">W</th>
          <th class="py-4 px-2 text-center font-medium">D</th>
          <th class="py-4 px-2 text-center font-medium">L</th>
          <th class="py-4 px-2 text-center hidden md:table-cell font-medium">PF</th>
          <th class="py-4 px-2 text-center hidden md:table-cell font-medium">PA</th>
          {formData && <th class="py-4 px-2 text-center hidden lg:table-cell font-medium">Form</th>}
          <th class="py-4 px-3 text-center font-medium">Pts</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {standings.map((s) => {
          const isHighlighted = s.entryId === highlightEntryId;
          const rankChange = getRankChange(s.rank, s.lastRank);
          const rankIcon = getRankIcon(s.rank, s.lastRank);
          const rankBorder = getRankBorder(s.rank);
          const mForm = formData?.[s.leagueEntryId];

          return (
            <tr class:list={[
              'table-row-hover transition-colors',
              rankBorder,
              isHighlighted && 'bg-emerald-500/5'
            ]}>
              <td class="py-3.5 px-4">
                <span class:list={[
                  'inline-flex items-center justify-center w-7 h-7 rounded-lg text-xs font-bold',
                  s.rank === 1 ? 'bg-amber-400/15 text-amber-400' :
                  s.rank === 2 ? 'bg-slate-300/15 text-slate-300' :
                  s.rank === 3 ? 'bg-amber-600/15 text-amber-600' :
                  'text-slate-400'
                ]}>
                  {s.rank}
                </span>
              </td>
              <td class="py-3.5 px-1">
                {rankIcon === 'up' && (
                  <span class="text-emerald-400 text-xs flex items-center gap-0.5">
                    <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 2l4 5H2z"/></svg>
                    {rankChange}
                  </span>
                )}
                {rankIcon === 'down' && (
                  <span class="text-rose-400 text-xs flex items-center gap-0.5">
                    <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 10L2 5h8z"/></svg>
                    {rankChange}
                  </span>
                )}
                {rankIcon === 'same' && (
                  <span class="text-slate-600 text-xs">=</span>
                )}
              </td>
              <td class="py-3.5 px-3">
                <span class="font-semibold text-white">{s.teamName}</span>
                <span class="sm:hidden text-slate-500 text-xs block mt-0.5">{s.playerName}</span>
              </td>
              <td class="py-3.5 px-3 text-slate-400 hidden sm:table-cell">{s.playerName}</td>
              <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">{s.played}</td>
              <td class="py-3.5 px-2 text-center text-emerald-400 font-semibold tabular-nums">{s.won}</td>
              <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">{s.drawn}</td>
              <td class="py-3.5 px-2 text-center text-rose-400 tabular-nums">{s.lost}</td>
              <td class="py-3.5 px-2 text-center text-slate-300 hidden md:table-cell tabular-nums">{s.pointsFor}</td>
              <td class="py-3.5 px-2 text-center text-slate-300 hidden md:table-cell tabular-nums">{s.pointsAgainst}</td>
              {formData && (
                <td class="py-3.5 px-2 text-center hidden lg:table-cell">
                  {mForm && (
                    <div class="flex items-center justify-center gap-1">
                      <div class="flex gap-0.5">
                        {mForm.form.slice(-5).map((pts: number) => (
                          <div
                            class:list={[
                              'w-1.5 h-4 rounded-full',
                              pts >= 60 ? 'bg-emerald-400' :
                              pts >= 40 ? 'bg-amber-400' :
                              'bg-rose-400'
                            ]}
                            title={`${pts} pts`}
                          />
                        ))}
                      </div>
                      {mForm.trend === 'up' && <svg class="w-3 h-3 text-emerald-400" viewBox="0 0 12 12" fill="currentColor"><path d="M6 2l4 5H2z"/></svg>}
                      {mForm.trend === 'down' && <svg class="w-3 h-3 text-rose-400" viewBox="0 0 12 12" fill="currentColor"><path d="M6 10L2 5h8z"/></svg>}
                      {mForm.trend === 'stable' && <span class="text-slate-500 text-xs">=</span>}
                    </div>
                  )}
                </td>
              )}
              <td class="py-3.5 px-3 text-center">
                <span class="text-lg font-bold text-fpl-cyan tabular-nums">{s.leaguePoints}</span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
