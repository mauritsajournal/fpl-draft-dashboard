---
interface Props {
  gameweek: number;
  standings: any[];
  managers: any[];
}

const { gameweek, standings, managers } = Astro.props;

const managerMap = new Map(managers.map((m: any) => [m.leagueEntryId, m]));
---

<div class="mt-10">
  <h2 class="text-xl font-bold text-white mb-1">GW{gameweek} Performance</h2>
  <p class="text-sm text-slate-500 mb-4">Points scored by each manager this gameweek</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {managers
      .sort((a: any, b: any) => {
        const aLast = a.currentForm?.[a.currentForm.length - 1] ?? 0;
        const bLast = b.currentForm?.[b.currentForm.length - 1] ?? 0;
        return bLast - aLast;
      })
      .map((m: any, i: number) => {
        const gwPoints = m.currentForm?.[m.currentForm.length - 1] ?? 0;
        return (
          <div class:list={[
            'glass-card-sm p-4 animate-fade-in-up',
            `stagger-${i + 1}`,
            i === 0 && 'glow-green'
          ]}>
            <div class="flex justify-between items-start mb-2">
              <div>
                <span class="text-sm font-medium text-slate-300">{m.playerName.split(' ')[0]}</span>
                <div class="text-xs text-slate-600 truncate mt-0.5">{m.teamName}</div>
              </div>
              <span class:list={[
                'text-3xl font-extrabold tabular-nums',
                i === 0 ? 'text-emerald-400' : 'text-white'
              ]}>{gwPoints}</span>
            </div>
            <div class="mt-3 flex gap-1 items-end h-4">
              {(m.currentForm ?? []).map((pts: number, j: number) => {
                const max = Math.max(...(m.currentForm ?? [1]));
                const height = max > 0 ? (pts / max) * 100 : 50;
                return (
                  <div
                    class:list={[
                      'flex-1 rounded-sm transition-all',
                      pts >= 60 ? 'bg-emerald-400/60' :
                      pts >= 40 ? 'bg-amber-400/60' :
                      'bg-rose-400/60'
                    ]}
                    style={`height: ${Math.max(height, 15)}%`}
                    title={`GW${gameweek - (m.currentForm?.length ?? 0) + j + 1}: ${pts} pts`}
                  />
                );
              })}
            </div>
          </div>
        );
      })}
  </div>
</div>
