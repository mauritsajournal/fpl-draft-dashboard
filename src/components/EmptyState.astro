---
interface Props {
  title: string;
  message?: string;
}

const {
  title,
  message = 'Data not yet available. The data pipeline needs to run first.'
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<div class="flex flex-col items-center justify-center py-20 text-center animate-fade-in-up">
  <div class="w-16 h-16 mb-6 text-slate-600">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
    </svg>
  </div>
  <h1 class="text-2xl font-bold bg-gradient-to-r from-fpl-green to-fpl-cyan bg-clip-text text-transparent mb-3">{title}</h1>
  <p class="text-slate-400 mb-6 max-w-md">{message}</p>
  <div class="flex gap-3">
    <a href={baseUrl} class="glass-card-sm px-5 py-2.5 text-sm text-slate-300 hover:text-white no-underline transition-all hover:bg-white/5">
      Back to Standings
    </a>
    <a href={`${baseUrl}status/`} class="glass-card-sm px-5 py-2.5 text-sm text-slate-300 hover:text-white no-underline transition-all hover:bg-white/5">
      Check Status
    </a>
  </div>
</div>
